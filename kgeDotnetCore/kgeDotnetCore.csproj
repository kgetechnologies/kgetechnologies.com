    <Compile Include="wwwroot\Controllers\HomeController.cs" />
    <Compile Include="wwwroot\Controllers\sitemapController.cs" />
    <Compile Include="wwwroot\Global.asax.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\Scripts\jquery-3.7.1.intellisense.js" />
    <None Include="wwwroot\Scripts\jquery.validate-vsdoc.js" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="wwwroot\sitemap.xml" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\Views\sitemap\" />
